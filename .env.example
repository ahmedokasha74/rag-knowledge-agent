# Select the providers and model IDs used by the application.
GENERATION_BACKEND=GROQ
GENERATION_MODEL_ID=your-generation-model-id
GROQ_API_KEY=

EMBEDDING_BACKEND=COHERE
EMBEDDING_MODEL_ID=your-embedding-model-id
EMBEDDING_MODEL_SIZE=1024
COHERE_API_KEY=

# Optional OpenAI provider credentials (only needed when selected).
OPENAI_API_KEY=
OPENAI_API_URL=

# Vector database settings. Qdrant is embedded and persisted locally.
VECTOR_DB_BACKEND=QDRANT
VECTOR_DB_PATH=qdrant_db
VECTOR_DB_DISTANCE_METHOD=cosine
SCORE_THRESHOLD=0.60

# Neo4j settings; these values must match the Docker Compose service.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password
NEO4J_DATABASE=neo4j

# Graph extraction uses this provider/model, falling back to generation settings.
GRAPH_EXTRACTION_BACKEND=GROQ
GRAPH_EXTRACTION_MODEL_ID=
